# Copy to .env. Never commit .env. DEEPSEEK_API_KEY and GEMINI_API_KEY live in ../../secrets/secrets.env.
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5174", "http://localhost:4174"]

# The booking service (github.com/rafi-seniang/tiketa-app). It owns films, seats and bookings and names every
# caller. The agent does not start without it.
BOOKING_API_URL=http://127.0.0.1:8070
# For the agent's two reads at startup. Empty while the booking service runs without API keys. Required in production.
BOOKING_API_KEY=
BOOKING_API_TIMEOUT_SECONDS=10

# The agent's own database: conversation owners and checkpoints (docker compose up -d postgres).
DATABASE_URL=postgresql+psycopg://tiketa:tiketa-local@127.0.0.1:5433/tiketa_agent
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./agent.db

# The chat model, any LiteLLM name. deepseek/... reads DEEPSEEK_API_KEY, gemini/... reads GEMINI_API_KEY.
LLM_MODEL=deepseek/deepseek-flash
# LLM_MODEL=gemini/gemini-3.8-flash
# low turns DeepSeek's thinking on (seat choices from a description: 3 of 3 right against 1 of 3), none off.
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.3
# Thinking counts as output tokens.
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# An OpenAI-compatible gateway in front of the model, for example Gatekeeper at http://127.0.0.1:8020/v1.
# Empty calls the provider directly. With a gateway, replies arrive whole (no token stream) and thinking is off.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=small
# Gatekeeper checks each visitor message first (injection, off-topic) with the scope it keeps as "tiketa".
# Empty skips the check. GATEKEEPER_API_KEY is one of Gatekeeper's TRUSTED_API_KEYS.
GATEKEEPER_URL=
GATEKEEPER_API_KEY=
GATEKEEPER_SCOPE_NAME=tiketa
MAX_MODEL_CALLS_PER_TURN=10
SUMMARIZE_FROM_TOKENS=8000
MESSAGES_KEPT_AFTER_SUMMARY=20
# Grades scripts/run_scenarios.py, a stronger model than the agent's.
JUDGE_MODEL=deepseek/deepseek-v4-pro

# Shared rate limit and one-turn-at-a-time lock (docker compose up -d redis). Empty keeps both per process.
REDIS_URL=redis://127.0.0.1:6383/0
RATE_LIMIT_PER_MINUTE=60
# Chat model tokens per UTC day: per caller, and for everyone together (the cap on the day's model bill)
DAILY_TOKENS_PER_CALLER=400000
DAILY_TOKENS_TOTAL=3000000
TURN_LOCK_SECONDS=180

# Traces of every run in Phoenix at http://localhost:6006 (docker compose up -d phoenix). Empty turns tracing off.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=tiketa
