# Copy to .env. Never commit .env. DEEPSEEK_API_KEY and GEMINI_API_KEY live in ../../secrets/secrets.env.
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated, empty disables auth (local only).
API_KEYS=
CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]

# Cinema data and conversation checkpoints (docker compose up -d postgres).
DATABASE_URL=postgresql+psycopg://tiketa:tiketa-local@127.0.0.1:5433/tiketa
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./tiketa.db

# The chat model, any LiteLLM name. deepseek/... reads DEEPSEEK_API_KEY, gemini/... reads GEMINI_API_KEY.
LLM_MODEL=deepseek/deepseek-flash
# LLM_MODEL=gemini/gemini-3.8-flash
# low turns DeepSeek's thinking on (seat choices from a description: 3 of 3 right against 1 of 3), none off.
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.3
# Thinking counts as output tokens.
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
MAX_MODEL_CALLS_PER_TURN=10
SUMMARIZE_FROM_TOKENS=8000
MESSAGES_KEPT_AFTER_SUMMARY=20
# Grades scripts/run_scenarios.py, a stronger model than the agent's.
JUDGE_MODEL=deepseek/deepseek-v4-pro

CINEMA_NAME=Tiketa Cinema
CINEMA_TIMEZONE=Asia/Jakarta
MAX_SEATS_PER_BOOKING=8

# Shared rate limit and one-turn-at-a-time lock (docker compose up -d redis). Empty keeps both per process.
REDIS_URL=redis://127.0.0.1:6383/0
RATE_LIMIT_PER_MINUTE=60
TURN_LOCK_SECONDS=180

# Traces of every run in Phoenix at http://localhost:6006 (docker compose up -d phoenix). Empty turns tracing off.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=tiketa
